# Copy to .env and fill in. Get a key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-key-here

# Repository the agent inspects. Defaults to the current working directory.
HISTORIAN_REPO=/path/to/some/git/repo

# Optional.
# HISTORIAN_WIRING=DELEGATE   # DELEGATE | TOOL  - how the changelog writer is attached
# HISTORIAN_TRACE=1           # print an execution trace on exit
# HISTORIAN_MAX_TOOLS=10      # refuse tool calls beyond this many
